#!/bin/sh
# gh credential dispatcher: routes masculinecache/* GitHub paths to the
# masculinecache gh config dir; everything else uses the default gh config.
op="${1:-get}"
tmp=$(mktemp)
cat > "$tmp"
path=$(sed -n 's/^path=//p' "$tmp")
if [ -n "$path" ] && [ "${path#masculinecache}" != "$path" ]; then
  GH_CONFIG_DIR="$HOME/.config/gh-masculinecache" /usr/bin/gh auth git-credential "$op" < "$tmp"
else
  /usr/bin/gh auth git-credential "$op" < "$tmp"
fi
status=$?
rm -f "$tmp"
exit $status
