#!/bin/bash
# no-mistakes daemon token single-source mechanism.
#
# Creates a systemd drop-in override that:
#   1. Stamps CF_AI_GATEWAY_TOKEN from ~/.agents/keys/default/.cf-ai-gw
#      (profile symlink) into a transient XDG_RUNTIME_DIR env file via ExecStartPre
#   2. Points EnvironmentFile to that transient location
#
# This eliminates duplication (token was in both .pi-env and as a standalone
# key file) and keeps the token out of git (all key locations are gitignored).
#
# The script discovers the hashed daemon unit name (no-mistakes-daemon-*.service)
# automatically, so it works across machines with different unit hashes.
#
# Fingerprint (token): {{ output "bash" "-c" "sha256sum ~/.agents/keys/default/.cf-ai-gw 2>/dev/null | cut -d' ' -f1" }}
set -euo pipefail

TOKEN_FILE="$HOME/.agents/keys/default/.cf-ai-gw"
SYSTEMD_USER_DIR="$HOME/.config/systemd/user"

# Discover the hashed daemon unit name
DAEMON_UNIT="$(basename "$SYSTEMD_USER_DIR"/no-mistakes-daemon-*.service 2>/dev/null | head -1 || true)"

if [[ -z "$DAEMON_UNIT" ]]; then
  echo "[no-mistakes-token] No daemon unit found; skipping (daemon not installed on this machine)"
  exit 0
fi

DAEMON_NAME="${DAEMON_UNIT%.service}"
OVERRIDE_DIR="$SYSTEMD_USER_DIR/${DAEMON_UNIT}.d"
OVERRIDE_CONF="$OVERRIDE_DIR/override.conf"

mkdir -p "$OVERRIDE_DIR"

# Use the user's actual runtime directory
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
ENV_FILE="$RUNTIME_DIR/no-mistakes-daemon.env"

cat >"$OVERRIDE_CONF" <<EOF
[Service]
ExecStartPre=/bin/bash -c 'token=\$(cat ~/.agents/keys/default/.cf-ai-gw); echo "CF_AI_GATEWAY_TOKEN=\$token" > $ENV_FILE'
EnvironmentFile=-$ENV_FILE
EOF

chmod 644 "$OVERRIDE_CONF"

echo "[no-mistakes-token] Installed drop-in override for $DAEMON_UNIT"
echo "[no-mistakes-token] Token source: $TOKEN_FILE"

# Reload systemd and restart daemon if running
if systemctl --user is-active --quiet "$DAEMON_NAME" 2>/dev/null; then
  systemctl --user daemon-reload
  systemctl --user restart "$DAEMON_NAME"
  echo "[no-mistakes-token] Daemon restarted to apply new token mechanism"
else
  systemctl --user daemon-reload
  echo "[no-mistakes-token] Daemon reload triggered (daemon is not active)"
fi
