#!/bin/bash
set -euo pipefail

KEY_LOADER="$HOME/.agents/keys/load-keys.sh"
if [[ ! -r "$KEY_LOADER" ]]; then
    echo "[warp-mdm] ERROR: key loader not found or unreadable: $KEY_LOADER" >&2
    exit 1
fi

unset WARP_FLEET_ENROLLMENT_CLIENT_ID WARP_FLEET_ENROLLMENT_CLIENT_SECRET

KEYS_ORIGINAL_HOME="$HOME"
KEYS_ISOLATED_HOME="$(mktemp -d)"
trap 'rm -rf "$KEYS_ISOLATED_HOME"' EXIT
mkdir -p "$KEYS_ISOLATED_HOME/.agents/keys"
ln -s "$KEYS_ORIGINAL_HOME/.agents/keys/default" "$KEYS_ISOLATED_HOME/.agents/keys/default"
KEYS_PROFILE="$(readlink "$KEYS_ORIGINAL_HOME/.agents/keys/default" 2>/dev/null || true)"
if [[ -n "$KEYS_PROFILE" && -d "$KEYS_ORIGINAL_HOME/.agents/keys/$KEYS_PROFILE" ]]; then
    ln -s "$KEYS_ORIGINAL_HOME/.agents/keys/$KEYS_PROFILE" "$KEYS_ISOLATED_HOME/.agents/keys/$KEYS_PROFILE"
fi
if [[ -x "$KEYS_ORIGINAL_HOME/.local/bin/jq" ]]; then
    mkdir -p "$KEYS_ISOLATED_HOME/.local/bin"
    ln -s "$KEYS_ORIGINAL_HOME/.local/bin/jq" "$KEYS_ISOLATED_HOME/.local/bin/jq"
fi
if [[ -z "${BWS_BIN:-}" ]]; then
    if KEYS_BWS_BIN="$(command -v bws 2>/dev/null)"; then
        export BWS_BIN="$KEYS_BWS_BIN"
    elif [[ -x "$KEYS_ORIGINAL_HOME/.local/share/mise/installs/bitwarden-secrets-manager/latest/bws" ]]; then
        export BWS_BIN="$KEYS_ORIGINAL_HOME/.local/share/mise/installs/bitwarden-secrets-manager/latest/bws"
    fi
fi
export HOME="$KEYS_ISOLATED_HOME"

# shellcheck disable=SC1091
. "$KEY_LOADER"
export HOME="$KEYS_ORIGINAL_HOME"

if [[ -z "${WARP_FLEET_ENROLLMENT_CLIENT_ID:-}" ]]; then
    echo "[warp-mdm] ERROR: WARP_FLEET_ENROLLMENT_CLIENT_ID is unset" >&2
    exit 1
fi
if [[ -z "${WARP_FLEET_ENROLLMENT_CLIENT_SECRET:-}" ]]; then
    echo "[warp-mdm] ERROR: WARP_FLEET_ENROLLMENT_CLIENT_SECRET is unset" >&2
    exit 1
fi

MDM_DIR="/var/lib/cloudflare-warp"
MDM_PATH="$MDM_DIR/mdm.xml"
MDM_TMP="$(mktemp)"
trap 'rm -f "$MDM_TMP"; rm -rf "$KEYS_ISOLATED_HOME"' EXIT

cat > "$MDM_TMP" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>auth_client_id</key><string>$WARP_FLEET_ENROLLMENT_CLIENT_ID</string>
  <key>auth_client_secret</key><string>$WARP_FLEET_ENROLLMENT_CLIENT_SECRET</string>
  <key>auto_connect</key><integer>1</integer>
  <key>onboarding</key><false />
  <key>organization</key><string>phillias</string>
  <key>service_mode</key><string>warp</string>
</dict>
</plist>
EOF

sudo -n mkdir -p "$MDM_DIR"
sudo -n install -m 600 "$MDM_TMP" "$MDM_PATH"
echo "[warp-mdm] installed $MDM_PATH"
