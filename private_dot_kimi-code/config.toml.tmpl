# GUARDRAILS (2026-10-07):
# - Default tui-via-vercel → Vercel AI Gateway vmc/kimi (1M context);
#   tui-via-cf → CF AI Gateway dynamic/kimi (200K context, ladder in
#   ROUTING_TOPOLOGY.md). CF handles failover internally.
# - Dead-lane models (404) are route-FATAL; 400 insufficient-credits
#   falls through. GOAT/PGS are subscriptions — heads fall through
#   until renewal window.
# - KIMI_CODE_CUSTOM_HEADERS in ~/.zshenv adds cf-aig headers for
#   direct gateway access outside this config.
# - See provider-catalog/references/d1/NO_MISTAKES_MODELS.md for full
#   per-harness config inventory and chain diagrams.
default_model = "tui-via-vercel"

[providers.cf-aig]
type = "openai_legacy"
base_url = "https://gateway.ai.cloudflare.com/v1/a7fa198dd5b359a187c671064fe6b36e/opencode/compat"
api_key_env = "CF_AI_GATEWAY_TOKEN"
custom_headers = { "cf-aig-gateway-id" = "opencode", "cf-aig-metadata" = "{\"harness\":\"kimi-code\",\"host\":\"{{ .chezmoi.hostname }}\",\"agent\":\"primary\"}" }

[models.tui-via-cf]
provider = "cf-aig"
model = "dynamic/kimi"
max_context_size = 200000
protocol = "openai"

[providers.vercel-aig]
type = "openai_legacy"
base_url = "https://ai-gateway.vercel.sh/v1"
api_key_env = "AI_GATEWAY_API_KEY"

[models.tui-via-vercel]
provider = "vercel-aig"
model = "vmc/kimi"
max_context_size = 1000000
protocol = "openai"
