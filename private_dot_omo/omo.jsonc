// OMO configuration
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "[opencode]": {
    "disabled_hooks": [
      "no-hephaestus-non-gpt"
    ],
    "model_fallback": true,
    "runtime_fallback": {
      "enabled": true,
      "retry_on_errors": [
        400,
        401,
        402,
        403,
        429,
        500,
        502,
        503,
        504,
        529
      ],
      "max_fallback_attempts": 3,
      "cooldown_seconds": 30,
      "timeout_seconds": 60,
      "notify_on_fallback": true
    },
    "team_mode": {
      "enabled": true,
      "max_parallel_members": 4,
      "max_members": 8,
      "tmux_visualization": true,
      "max_messages_per_run": 10000,
      "max_wall_clock_minutes": 120,
      "max_member_turns": 500,
      "message_payload_max_bytes": 32768,
      "recipient_unread_max_bytes": 262144,
      "mailbox_poll_interval_ms": 3000
    },
    "tmux": {
      "enabled": true,
      "layout": "main-vertical",
      "main_pane_size": 60,
      "main_pane_min_width": 120,
      "agent_pane_min_width": 40
    },
    "background_task": {
      "defaultConcurrency": 6,
      "providerConcurrency": {
        "opencode": 12,
        "opencode-zen": 10,
        "opencode-go": 6,
        "openrouter": 4,
        "cloudflare": 8,
        "nvidia": 4,
        "baseten": 3,
        "agnes": 3,
        "intern": 3,
        "together": 4
      },
      "modelConcurrency": {
        "opencode-zen/big-pickle": 2,
        "opencode-go/kimi-k2.6": 2,
        "opencode-go/deepseek-v4-pro": 2,
        "opencode-go/gpt-5.5": 2,
        "opencode-go/gpt-5.4": 2,
        "opencode-go/gpt-5.3-codex": 2,
        "opencode-go/glm-5.1": 2,
        "opencode-go/deepseek-v4-flash": 8,
        "opencode-zen/kimi-k2.6": 2,
        "cloudflare/@cf/meta/llama-3.3-70b-instruct-fp8-fast": 4,
        "cloudflare/@cf/openai/gpt-oss-120b": 2,
        "cloudflare/@cf/qwen/qwen2.5-coder-32b-instruct": 2,
        "cloudflare/@cf/moonshotai/kimi-k2.7-code": 2,
        "cloudflare/@cf/nvidia/nemotron-3-120b-a12b": 2,
        "cloudflare/@cf/google/gemma-4-26b-a4b-it": 2,
        "cloudflare/@cf/zai-org/glm-4.7-flash": 4,
        "agnes/agnes-2.0-flash": 2,
        "agnes/agnes-1.5-flash": 3,
        "nvidia/deepseek-ai/deepseek-v4-flash": 2,
        "nvidia/nvidia/nemotron-3-super-120b-a12b": 2,
        "baseten/openai/gpt-oss-120b": 2,
        "openrouter/poolside/laguna-s-2.1:free": 2,
        "intern/intern-s2-preview-397b": 2
      }
    },
    "agents": {
      "sisyphus": {
        "model": "opencode-zen/big-pickle",
        "ultrawork": {
          "model": "opencode-zen/big-pickle",
          "variant": "xhigh"
        },
        "fallback_models": [
          "nvidia/deepseek-ai/deepseek-v4-flash",
          "opencode-go/kimi-k2.6",
          "cloudflare/@cf/moonshotai/kimi-k2.7-code",
          "baseten/openai/gpt-oss-120b",
          "mistral/mistral-large-latest",
          "google/gemini-2.0-flash"
        ]
      },
      "sisyphus-junior": {
        "model": "opencode-zen/nemotron-3-ultra-free",
        "fallback_models": [
          "openrouter/nvidia/nemotron-3-super-120b-a12b:free",
          "agnes/agnes-1.5-flash",
          "opencode-zen/deepseek-v4-flash-free",
          "opencode-go/deepseek-v4-flash"
        ]
      },
      "hephaestus": {
        "model": "opencode-go/gpt-5.5",
        "permission": {
          "teammate": "allow"
        },
        "fallback_models": [
          "opencode-zen/gpt-5.5",
          "opencode-zen/gpt-5.4",
          "cloudflare/@cf/moonshotai/kimi-k2.7-code",
          "opencode-zen/nemotron-3-ultra-free",
          "openrouter/qwen/qwen3-coder:free"
        ]
      },
      "prometheus": {
        "model": "opencode-zen/big-pickle",
        "fallback_models": [
          "nvidia/deepseek-ai/deepseek-v4-flash",
          "opencode-go/kimi-k2.6",
          "cloudflare/@cf/moonshotai/kimi-k2.7-code",
          "opencode-go/deepseek-v4-pro"
        ]
      },
      "metis": {
        "model": "opencode-go/glm-5.1",
        "temperature": 0.3,
        "fallback_models": [
          "nvidia/z-ai/glm-5.2",
          "cloudflare/@cf/zai-org/glm-5.2",
          "opencode-zen/glm-5.1",
          "openrouter/nvidia/nemotron-3-super-120b-a12b:free",
          "opencode-zen/deepseek-v4-flash-free",
          "opencode-go/deepseek-v4-flash"
        ]
      },
      "momus": {
        "model": "opencode/gpt-5.5",
        "variant": "xhigh",
        "fallback_models": [
          "opencode-zen/gpt-5.5-pro",
          "cloudflare/@cf/moonshotai/kimi-k2.7-code",
          "opencode-zen/big-pickle",
          "opencode/deepseek-v4-pro",
          "opencode-zen/kimi-k2.6"
        ]
      },
      "atlas": {
        "model": "opencode-go/deepseek-v4-flash",
        "fallback_models": [
          "nvidia/deepseek-ai/deepseek-v4-flash",
          "cloudflare/@cf/qwen/qwen2.5-coder-32b-instruct",
          "opencode-go/kimi-k2.6",
          "sambanova/Meta-Llama-3.3-70B-Instruct"
        ]
      },
      "oracle": {
        "model": "opencode/gpt-5.5",
        "variant": "xhigh",
        "fallback_models": [
          "opencode-zen/gpt-5.5-pro",
          "nvidia/thinkingmachines/inkling",
          "cloudflare/@cf/nvidia/nemotron-3-120b-a12b",
          "opencode-zen/big-pickle",
          "baseten/openai/gpt-oss-120b",
          "opencode/deepseek-v4-pro",
          "together/deepseek-ai/DeepSeek-R1"
        ]
      },
      "explore": {
        "model": "opencode-zen/deepseek-v4-flash-free",
        "temperature": 0.1,
        "fallback_models": [
          "cloudflare/@cf/moonshotai/kimi-k2.7-code",
          "cloudflare/@cf/openai/gpt-oss-120b",
          "cloudflare/@cf/nvidia/nemotron-3-120b-a12b",
          "nvidia/deepseek-ai/deepseek-v4-flash",
          "openrouter/poolside/laguna-s-2.1:free",
          "opencode-go/deepseek-v4-flash",
          "google/gemini-2.0-flash"
        ],
        "permission": {
          "edit": "allow",
          "bash": "allow"
        }
      },
      "librarian": {
        "model": "opencode-zen/deepseek-v4-flash-free",
        "temperature": 0.1,
        "fallback_models": [
          "cloudflare/@cf/moonshotai/kimi-k2.7-code",
          "cloudflare/@cf/openai/gpt-oss-120b",
          "cloudflare/@cf/nvidia/nemotron-3-120b-a12b",
          "nvidia/deepseek-ai/deepseek-v4-flash",
          "openrouter/poolside/laguna-s-2.1:free",
          "opencode-go/deepseek-v4-flash",
          "google/gemini-2.0-flash"
        ]
      },
      "multimodal-looker": {
        // Bonsai OK here — single-shot vision look_at calls, no tool loop (Known Failure restriction in opencode-omo-config SKILL.md)
        "model": "together/Prism-ML/Ternary-Bonsai-27B",
        "fallback_models": [
          "cloudflare/@cf/google/gemma-4-26b-a4b-it",
          "openrouter/nvidia/nemotron-nano-12b-v2-vl:free",
          "opencode-zen/mimo-v2.5-free",
          "opencode-zen/nemotron-3-ultra-free"
        ]
      },
      "science": {
        "model": "intern/intern-s2-preview-397b",
        "description": "Scientific reasoning, biomolecular design, material structure, multimodal scientific tasks",
        "fallback_models": [
          "nvidia/thinkingmachines/inkling",
          "opencode-go/glm-5.1",
          "opencode-zen/big-pickle"
        ]
      },
      "quick": {
        "model": "opencode-zen/nemotron-3-ultra-free",
        "fallback_models": [
          "nvidia/nvidia/nemotron-3-super-120b-a12b",
          "openrouter/nvidia/nemotron-3-super-120b-a12b:free",
          "openrouter/poolside/laguna-s-2.1:free",
          "agnes/agnes-1.5-flash",
          "opencode-zen/deepseek-v4-flash-free",
          "opencode-go/deepseek-v4-flash"
        ]
      },
      "unspecified-low": {
        "model": "opencode-zen/nemotron-3-ultra-free",
        "fallback_models": [
          "nvidia/nvidia/nemotron-3-super-120b-a12b",
          "openrouter/nvidia/nemotron-3-super-120b-a12b:free",
          "openrouter/poolside/laguna-s-2.1:free",
          "agnes/agnes-1.5-flash",
          "opencode-zen/deepseek-v4-flash-free",
          "opencode-go/deepseek-v4-flash"
        ]
      }
    },
    "categories": {
      "visual-engineering": {
        "model": "opencode/gpt-5.3-codex",
        "fallback_models": [
          "opencode-zen/gpt-5.3-codex",
          "openrouter/nvidia/nemotron-nano-12b-v2-vl:free",
          "opencode-zen/deepseek-v4-flash-free",
          "opencode-go/deepseek-v4-flash"
        ]
      },
      "ultrabrain": {
        "model": "opencode-go/deepseek-v4-pro",
        "variant": "xhigh",
        "fallback_models": [
          "nvidia/deepseek-ai/deepseek-v4-pro",
          "cloudflare/@cf/deepseek-ai/deepseek-r1-distill-qwen-32b",
          "opencode-zen/big-pickle",
          "baseten/nvidia/Nemotron-120B-A12B",
          "mistral/mistral-large-latest"
        ]
      },
      "deep": {
        "model": "opencode-zen/big-pickle",
        "fallback_models": [
          "nvidia/deepseek-ai/deepseek-v4-pro",
          "cloudflare/@cf/openai/gpt-oss-120b",
          "opencode-go/kimi-k2.6",
          "baseten/openai/gpt-oss-120b"
        ]
      },
      "artistry": {
        "model": "cloudflare/@cf/google/gemma-4-26b-a4b-it",
        "fallback_models": [
          "opencode-zen/mimo-v2.5-free",
          "openrouter/horizon-beta"
        ]
      },
      "quick": {
        "model": "cloudflare/@cf/openai/gpt-oss-20b",
        "fallback_models": [
          "nvidia/nvidia/nemotron-3-super-120b-a12b",
          "cloudflare/@cf/zai-org/glm-4.7-flash",
          "agnes/agnes-1.5-flash",
          "opencode-zen/mimo-v2.5-free"
        ]
      },
      "unspecified-low": {
        "model": "opencode-zen/nemotron-3-ultra-free",
        "fallback_models": [
          "nvidia/nvidia/nemotron-3-super-120b-a12b",
          "openrouter/nvidia/nemotron-3-super-120b-a12b:free",
          "agnes/agnes-1.5-flash",
          "opencode-zen/deepseek-v4-flash-free",
          "opencode-go/deepseek-v4-flash"
        ]
      },
      "unspecified-high": {
        "model": "opencode-zen/big-pickle",
        "fallback_models": [
          "nvidia/deepseek-ai/deepseek-v4-flash",
          "opencode-go/kimi-k2.6",
          "cloudflare/@cf/nvidia/nemotron-3-120b-a12b",
          "baseten/openai/gpt-oss-120b",
          "mistral/mistral-large-latest"
        ]
      },
      "writing": {
        "model": "opencode-zen/deepseek-v4-flash-free",
        "fallback_models": [
          "cloudflare/@cf/zai-org/glm-4.7-flash",
          "opencode-zen/mimo-v2.5-free",
          "openrouter/meta-llama/llama-3.3-70b-instruct:free",
          "google/gemini-2.0-flash"
        ]
      }
    }
  },
  "_migrations": [
    "2026-07-opencode-config-unification"
  ]
}
