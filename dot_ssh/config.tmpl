# OS-specific cloudflared path
{{- $cloudflared := "/usr/bin/cloudflared" }}
{{- if eq .chezmoi.os "darwin" }}
{{-   $cloudflared = "/opt/homebrew/bin/cloudflared" }}
{{- end }}

# Default SSH user
{{- $ssh_user := .chezmoi.username }}

Host github.com
  AddKeysToAgent yes
  # Registered deploy keys first: id_ed25519_inspironkali is passphrase-protected
  # and unregistered with GitHub on most fleet hosts, so listing it first hangs
  # any non-interactive fetch (cron, agent panes, treehouse) on a passphrase prompt.
  IdentityFile ~/.ssh/chezmoi-deploy-key
  IdentityFile ~/.ssh/id_ed25519_inspironkali
  IdentitiesOnly yes 

Host github-mybiz
  HostName github.com
  User git
  IdentityFile ~/.ssh/mybiz-deploy-key
  IdentitiesOnly yes

Host github.com-pirate
  HostName github.com
  User git
  IdentityFile ~/.ssh/pirate-deploy-key
  IdentitiesOnly yes

Host github.com-selfhost
  HostName github.com
  User git
  IdentityFile ~/.ssh/selfhost-deploy-key
  IdentitiesOnly yes

Host rapidseedbox
  HostName 45.152.210.245
  Port 2222
  User root
  IdentityFile ~/.ssh/id_ed25519_rapidseedbox
  IdentitiesOnly yes

Host gcp
  IdentityFile ~/.ssh/id_ed25519_inspironkali
  HostName gcp.phillias.us

Host ora
  IdentityFile ~/.ssh/id_ed25519_inspironkali
  HostName ora.phillias.us
  User ubuntu

Host primary55522
  IdentityFile ~/.ssh/id_ed25519_inspironkali
  HostName primary55522.phillias.cc
  ProxyCommand {{ $cloudflared }} access ssh --hostname %h
  User ubuntu

Host kali
  IdentityFile ~/.ssh/id_ed25519_inspironkali
  HostName kali.phillias.us
  ProxyCommand {{ $cloudflared }} access ssh --hostname %h
  User phillias

Host kalione
  IdentityFile ~/.ssh/id_ed25519_inspironkali
  HostName ssh.phillias.org
  ProxyCommand {{ $cloudflared }} access ssh --hostname %h
  User phillias

# Fleet mesh aliases — data-driven from .chezmoidata/fleet.toml (.fleet.nodes).
# One Host block per registered node: the fleet-* alias every node uses to
# reach that node (autossh tunnel units, fleet-chat, agent panes). Transport
# is cloudflared access + the shared passphraseless chezmoi-deploy-key.
# Greenfield: scripts/setup.sh Phase 7b probes these aliases post-apply to
# record host keys (accept-new) and syncs every fleet deploy key into
# authorized_keys. accept-new is deliberate — autossh cannot answer the
# first-connect host-key prompt.
{{- range $name, $node := .fleet.nodes }}
Host {{ $node.ssh_alias }}
  HostName {{ $node.access_host }}
  User {{ $node.ssh_user }}
  IdentityFile ~/.ssh/chezmoi-deploy-key
  IdentitiesOnly yes
  ProxyCommand {{ $cloudflared }} access ssh --hostname %h
  StrictHostKeyChecking accept-new
{{- end }}

# Cloudflare Tunnel SSH keepalive - prevent Gateway 270s idle timeout
Host *cloudflared* *
  ServerAliveInterval 30
  ServerAliveCountMax 3
  TCPKeepAlive yes

# ET — Eternal Terminal host aliases (for CLI et connections)
# Usage: et et-kali  (connects to etserver via tunnel DNS on port 2022)
Host et-kali
  HostName 127.0.0.1
  Port 55554
  User phillias
  IdentityFile ~/.ssh/id_ed25519_kali

# STALE: et.phillias.cc resolves to primary's grey-cloud IP, which has no
# :22 listener — this alias no longer connects. Kept for reference only.
Host et-55522
  HostName et.phillias.cc
  Port 22
  User ubuntu

Host et-kalione
  HostName et.phillias.org
  Port 22
  User phillias

# et-oci1 — oci1 ET via direct exposure (no cloudflared, no sslh).
# et.phillias.net is a grey-cloud A record to oci1 (147.224.180.103); sshd on
# :22 bootstraps, etserver on :2022. Usage: et -u ubuntu et-oci1
Host et-oci1
  HostName et.phillias.net
  Port 22
  HostKeyAlias et-oci1
  User ubuntu
  IdentityFile ~/.ssh/id_ed25519_inspironkali
  IdentitiesOnly yes
  AddKeysToAgent yes
{{- if eq .chezmoi.os "darwin" }}
  UseKeychain yes
{{- end }}

# oci1 — Oracle Cloud selfhost (direct reserved IP)
Host oci1
  HostName 147.224.180.103
  User ubuntu
  IdentityFile ~/.ssh/id_ed25519_inspironkali
  IdentitiesOnly yes
