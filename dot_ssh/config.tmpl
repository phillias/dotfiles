# OS-specific cloudflared path
{{- $cloudflared := "/usr/bin/cloudflared" }}
{{- if eq .chezmoi.os "darwin" }}
{{-   $cloudflared = "/opt/homebrew/bin/cloudflared" }}
{{- end }}

# Default SSH user
{{- $ssh_user := .chezmoi.username }}

Host github.com
  AddKeysToAgent yes
  # Registered deploy keys first: id_ed25519_inspironkali is passphrase-protected
  # and unregistered with GitHub on most fleet hosts, so listing it first hangs
  # any non-interactive fetch (cron, agent panes, treehouse) on a passphrase prompt.
  IdentityFile ~/.ssh/chezmoi-deploy-key
  IdentityFile ~/.ssh/id_ed25519_inspironkali
  IdentitiesOnly yes 

Host github-mybiz
  HostName github.com
  User git
  IdentityFile ~/.ssh/mybiz-deploy-key
  IdentitiesOnly yes

Host github.com-pirate
  HostName github.com
  User git
  IdentityFile ~/.ssh/pirate-deploy-key
  IdentitiesOnly yes

Host github.com-selfhost
  HostName github.com
  User git
  IdentityFile ~/.ssh/selfhost-deploy-key
  IdentitiesOnly yes

Host rapidseedbox
  HostName 45.152.210.245
  Port 2222
  User root
  IdentityFile ~/.ssh/id_ed25519_rapidseedbox
  IdentitiesOnly yes

Host gcp
  IdentityFile ~/.ssh/id_ed25519_inspironkali
  HostName gcp.phillias.us

Host ora
  IdentityFile ~/.ssh/id_ed25519_inspironkali
  HostName ora.phillias.us
  User ubuntu

Host ssh.phillias.us
  IdentityFile ~/.ssh/id_ed25519_inspironkali
  HostKeyAlias ssh.phillias.us
  HostName ssh.phillias.us
  ProxyCommand {{ $cloudflared }} access ssh --hostname %h
  User phillias

Host ssh.phillias.net
  IdentityFile ~/.ssh/id_ed25519_inspironkali
  HostKeyAlias ssh.phillias.net
  HostName ssh.phillias.net
  ProxyCommand {{ $cloudflared }} access ssh --hostname %h
  User ubuntu

Host ssh.phillias.org
  IdentityFile ~/.ssh/id_ed25519_inspironkali
  HostKeyAlias ssh.phillias.org
  HostName ssh.phillias.org
  ProxyCommand {{ $cloudflared }} access ssh --hostname %h
  User phillias

Host ssh.phillias.cc
  IdentityFile ~/.ssh/id_ed25519_inspironkali
  HostKeyAlias ssh.phillias.cc
  HostName ssh.phillias.cc
  ProxyCommand {{ $cloudflared }} access ssh --hostname %h
  User ubuntu

# Fleet mesh aliases — data-driven from .chezmoidata/fleet.toml (.fleet.nodes).
# One Host block per registered node: the fleet-* alias every node uses to
# reach that node (fleet SSH, agent panes). Transport
# is the fleet mesh transport + the shared passphraseless chezmoi-deploy-key.
# Greenfield: scripts/setup.sh Phase 7b probes these aliases post-apply to
# record host keys (accept-new) and syncs every fleet deploy key into
# authorized_keys. accept-new is deliberate — non-interactive SSH cannot
# answer the first-connect host-key prompt.
{{- range $name, $node := .fleet.nodes }}
Host {{ $node.ssh_alias }}
  HostName {{ $node.mesh_ip }}
  User {{ $node.ssh_user }}
  IdentityFile ~/.ssh/chezmoi-deploy-key
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
{{- end }}

# Cloudflare Tunnel SSH keepalive - prevent Gateway 270s idle timeout
Host *cloudflared* *
  ServerAliveInterval 30
  ServerAliveCountMax 3
  TCPKeepAlive yes

# mem-bare git remote on primary (WARP mesh)
Host mem-primary
  HostName {{ .fleet.nodes.primary.mesh_ip }}
  User {{ .fleet.nodes.primary.ssh_user }}
  IdentityFile ~/.ssh/chezmoi-deploy-key
  IdentitiesOnly yes

# oci1 — Oracle Cloud selfhost (direct reserved IP)
Host oci1
  HostName 147.224.180.103
  User ubuntu
  IdentityFile ~/.ssh/id_ed25519_inspironkali
  IdentitiesOnly yes
