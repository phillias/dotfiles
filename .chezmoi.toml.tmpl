encryption = "age"
[age]
    identity = "~/.config/chezmoi/key.txt"
    recipient = "age1p5cu2lhvhjxq2rkzxlgk9ekknr3ang7n5nla5pst94ckm8jmmq9sp66mc5"

[data.fleet]
{{- $dnsDomain := "phillias.org" }}
{{- if eq .chezmoi.hostname "primary" }}
{{-   $dnsDomain = "phillias.cc" }}
{{- else if eq .chezmoi.hostname "InspironOne" }}
{{-   $dnsDomain = "phillias.us" }}
{{- else if eq .chezmoi.hostname "oci1" }}
{{-   $dnsDomain = "phillias.net" }}
{{- else }}
{{-   range $name, $node := .fleet.nodes }}
{{-     if and (eq $node.hostname .chezmoi.hostname) $node.dns_domain }}
{{-       $dnsDomain = $node.dns_domain }}
{{-     end }}
{{-   end }}
{{- end }}
    dnsDomain = "{{ $dnsDomain }}"
