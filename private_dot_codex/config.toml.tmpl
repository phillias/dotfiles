model = "openai/gpt-5.5"
model_provider = "vercel-aig"

[features]
hooks = true

[shell_environment_policy]
inherit = "all"

[model_providers.vercel-aig]
name = "Vercel AI Gateway"
base_url = "https://ai-gateway.vercel.sh/codex/v1"
env_key = "AI_GATEWAY_API_KEY"

[model_providers.cf-aig]
name = "CF AI Gateway"
base_url = "https://gateway.ai.cloudflare.com/v1/a7fa198dd5b359a187c671064fe6b36e/opencode/compat"
env_key = "CF_AI_GATEWAY_TOKEN"

http_headers = { "cf-aig-gateway-id" = "opencode", "cf-aig-metadata" = "{\"harness\":\"codex\",\"host\":\"{{ .chezmoi.hostname }}\",\"agent\":\"primary\"}" }

[model_providers.openrouter-direct]
name = "OpenRouter direct (harness-gated models)"
base_url = "https://openrouter.ai/api/v1"
env_key = "OPENROUTER_API_KEY"
wire_api = "responses"

[profiles.cf]
model_provider = "cf-aig"
model = "dynamic/codex"

[profiles.vercel]
model_provider = "vercel-aig"
model = "vmc/codex"
