# GUARDRAILS (2026-10-07):
# - Default route is vercel-aig → gpt-5.5 (Vercel AI Gateway virtual model).
# - [profiles.cf] uses CF AI Gateway dynamic/codex route (ladder in
#   ROUTING_TOPOLOGY.md). CF route handles failover internally; codex
#   profiles.cf is a fallback when Vercel is down.
# - Dead-lane models (404) are route-FATAL; 400 insufficient-credits falls
#   through to next rung. GOAT/PGS are subscriptions — heads fall through
#   until renewal window.
# - See provider-catalog/references/d1/NO_MISTAKES_MODELS.md for full
#   per-harness config inventory and chain diagrams.
model = "openai/gpt-5.5"
model_provider = "vercel-aig"

[features]
hooks = true

[shell_environment_policy]
inherit = "all"

[model_providers.vercel-aig]
name = "Vercel AI Gateway"
base_url = "https://ai-gateway.vercel.sh/codex/v1"
env_key = "AI_GATEWAY_API_KEY"

[model_providers.cf-aig]
name = "CF AI Gateway"
base_url = "https://gateway.ai.cloudflare.com/v1/a7fa198dd5b359a187c671064fe6b36e/opencode/compat"
env_key = "CF_AI_GATEWAY_TOKEN"

http_headers = { "cf-aig-gateway-id" = "opencode", "cf-aig-metadata" = "{\"harness\":\"codex\",\"host\":\"{{ .chezmoi.hostname }}\",\"agent\":\"primary\"}" }

[model_providers.openrouter-direct]
name = "OpenRouter direct (harness-gated models)"
base_url = "https://openrouter.ai/api/v1"
env_key = "OPENROUTER_API_KEY"
wire_api = "responses"

[profiles.cf]
model_provider = "cf-aig"
model = "dynamic/codex"
