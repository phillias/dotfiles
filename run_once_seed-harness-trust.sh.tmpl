#!/usr/bin/env bash
# Non-clobbering seed for harness trust stores (idempotent; adds entries without overwriting runtime state or clobbering appends by the harness).
# Run once by chezmoi on apply. Matches firstmate decision for Claude (.claude.json), Pi (trust.json), and Grok (trusted_folders.toml).
# Uses {{ .chezmoi.homeDir }}; only verified syntax from tool stores.

set -e

HOME="{{ .chezmoi.homeDir }}"
echo "Seeding harness trust for $HOME (non-clobbering)"

if ! command -v jq >/dev/null 2>&1; then
  echo "jq not found; cannot safely merge trust stores" >&2
  exit 1
fi

# Claude: real store is ~/.claude.json; merge projects entries (never authoritative render)
CLAUDE_JSON="$HOME/.claude.json"
CLAUDE_LOCK="$CLAUDE_JSON.lock"
if [ ! -f "$CLAUDE_JSON" ]; then
  mkdir -p "$(dirname "$CLAUDE_JSON")"
  echo '{}' > "$CLAUDE_JSON"
fi
(
  flock -w 10 200 || { echo "could not lock $CLAUDE_JSON" >&2; exit 1; }
  jq --arg home "$HOME" '
    .projects = (.projects // {}) |
    .projects[$home + "/firstmate"] = (.projects[$home + "/firstmate"] // {}) | .projects[$home + "/firstmate"].hasTrustDialogAccepted = true |
    .projects[$home + "/.local/share/chezmoi"] = (.projects[$home + "/.local/share/chezmoi"] // {}) | .projects[$home + "/.local/share/chezmoi"].hasTrustDialogAccepted = true
  ' "$CLAUDE_JSON" > "$CLAUDE_JSON.tmp"
  mv "$CLAUDE_JSON.tmp" "$CLAUDE_JSON"
  jq -e --arg home "$HOME" '
    .projects[$home + "/firstmate"].hasTrustDialogAccepted == true and
    .projects[$home + "/.local/share/chezmoi"].hasTrustDialogAccepted == true
  ' "$CLAUDE_JSON" >/dev/null || { echo "Claude trust seed did not land in $CLAUDE_JSON" >&2; exit 1; }
) 200>"$CLAUDE_LOCK"
echo "Claude trust seeded in $CLAUDE_JSON"

# Pi: real store is ~/.pi/agent/trust.json (flat "<path>": true map); merge entries (never authoritative render)
PI_TRUST_JSON="$HOME/.pi/agent/trust.json"
PI_LOCK="$PI_TRUST_JSON.lock"
mkdir -p "$(dirname "$PI_TRUST_JSON")"
if [ ! -f "$PI_TRUST_JSON" ]; then
  echo '{}' > "$PI_TRUST_JSON"
fi
(
  flock -w 10 200 || { echo "could not lock $PI_TRUST_JSON" >&2; exit 1; }
  jq --arg a "$HOME/firstmate" --arg b "$HOME/.local/share/chezmoi" '.[$a] = true | .[$b] = true' "$PI_TRUST_JSON" > "$PI_TRUST_JSON.tmp"
  mv "$PI_TRUST_JSON.tmp" "$PI_TRUST_JSON"
  jq -e --arg a "$HOME/firstmate" --arg b "$HOME/.local/share/chezmoi" '.[$a] == true and .[$b] == true' "$PI_TRUST_JSON" >/dev/null || { echo "Pi trust seed did not land in $PI_TRUST_JSON" >&2; exit 1; }
) 200>"$PI_LOCK"
echo "Pi trust seeded in $PI_TRUST_JSON"

# Grok: append to trusted_folders.toml if not present (non-clobber; harness appends at runtime)
GROK_DIR="$HOME/.grok"
GROK_TOML="$GROK_DIR/trusted_folders.toml"
GROK_LOCK="$GROK_TOML.lock"
mkdir -p "$GROK_DIR"
if [ ! -f "$GROK_TOML" ]; then
  cat > "$GROK_TOML" << 'EOF'
# Seeded by chezmoi run_once (non-clobbering; harness appends additional entries at runtime)
EOF
fi
(
  flock -w 10 200 || { echo "could not lock $GROK_TOML" >&2; exit 1; }
  for p in "$HOME/firstmate" "$HOME/.local/share/chezmoi"; do
    escaped=$(echo "$p" | sed 's/[]\/$*.^|[]/\\&/g')
    if ! grep -q "\[folders\.[\"']${escaped}[\"']\]" "$GROK_TOML" 2>/dev/null; then
      cat >> "$GROK_TOML" <<EOF

[folders."$p"]
trusted = true
decided_at = $(date +%s)
EOF
      echo "Grok trust seeded for $p"
    fi
  done
) 200>"$GROK_LOCK"

# Codex's [projects.*] trust_level entries live in the authoritative
# private_dot_codex/config.toml.tmpl render, not here. Kimi's store is keyed by an
# unverified hash of the path (~/.kimi-code/workspace-trust/wd_<name>_<hash>) and is
# left unseeded.

echo "Harness trust seeding complete (idempotent; survives runtime writes and chezmoi apply)."
chmod 600 "$CLAUDE_JSON" "$PI_TRUST_JSON" "$GROK_TOML" 2>/dev/null || true
