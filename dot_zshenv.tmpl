# shellcheck shell=sh
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Identity router lives in ~/.local/bin/gh, so it must precede mise shims:
# with binaries first, bare `gh` reaches the router; its own self-skip PATH
# scan then resolves the mise-managed gh shim on passthrough. mise shims must
# still be on PATH in non-interactive shells too: .zshrc only runs
# `mise activate` for interactive zsh, so headless callers (scripts, daemons,
# cron, zsh -lc) never see tools like pi/node without this.
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

# Load keys from the default profile (~/.agents/keys/default symlink).
# This makes all provider keys available to non-interactive shells.
if [ -r "$HOME/.agents/keys/load-keys.sh" ]; then
    . "$HOME/.agents/keys/load-keys.sh"
fi

# Route Kimi Code through CF AI Gateway (already configured in ~/.kimi-code/config.toml)
export KIMI_CODE_CUSTOM_HEADERS=$'cf-aig-gateway-id: opencode\ncf-aig-metadata: {"harness":"kimi-code","host":"{{ .chezmoi.hostname }}","agent":"primary"}'

# Route Claude Code through CF AI Gateway
# NOTE 2026-09-19: Claude Code (Anthropic Messages protocol) cannot ride the
# dynamic/claude route yet. The /compat endpoint rejects /v1/messages (400
# code 2019); the REST API /ai/v1/messages accepts the request but the
# dynamic route answers in OpenAI chat.completion shape, so Claude's SSE
# parser hangs. Compat URL kept for fast-fail. Lanes that CAN consume
# dynamic/claude: opencode, pi, codex, grok, kimi (OpenAI protocol). muse
# dropped 2026-09-19: Muse Code 1.3.0 speaks the Meta Responses wire and the
# public build compiles out the openai adapters, so it cannot ride the compat
# plane — it talks to api.meta.ai natively (META_API_KEY via load-keys.sh).
export ANTHROPIC_BASE_URL="https://gateway.ai.cloudflare.com/v1/a7fa198dd5b359a187c671064fe6b36e/opencode/compat"
export ANTHROPIC_API_KEY="$CF_AI_GATEWAY_TOKEN"
export ANTHROPIC_CUSTOM_HEADERS=$'cf-aig-gateway-id: opencode\ncf-aig-metadata: {"harness":"claude","host":"{{ .chezmoi.hostname }}","agent":"primary"}'

# Route Codex through CF AI Gateway  
export OPENAI_BASE_URL="https://gateway.ai.cloudflare.com/v1/a7fa198dd5b359a187c671064fe6b36e/opencode/compat"
export OPENAI_API_KEY="$CF_AI_GATEWAY_TOKEN"
