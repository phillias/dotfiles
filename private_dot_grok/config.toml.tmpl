# GUARDRAILS (2026-10-07):
# - Default route vmc/grok → Vercel AI Gateway; dynamic/grok → CF AI Gateway
#   (ladder in ROUTING_TOPOLOGY.md). CF handles failover internally.
# - Dead-lane models (404) are route-FATAL; 400 insufficient-credits falls
#   through. GOAT/PGS are subscriptions — heads fall through until renewal.
# - See provider-catalog/references/d1/NO_MISTAKES_MODELS.md for full
#   per-harness config inventory and chain diagrams.
[marketplace]
default_skills_installs_purged = true

[models]
default = "vmc/grok"

[model."dynamic/grok"]
model = "dynamic/grok"
base_url = "https://gateway.ai.cloudflare.com/v1/a7fa198dd5b359a187c671064fe6b36e/opencode/compat"
name = "CF AI Gateway (dynamic/grok)"
env_key = "CF_AI_GATEWAY_TOKEN"
api_backend = "chat_completions"
extra_headers = { "cf-aig-gateway-id" = "opencode", "cf-aig-metadata" = "{\"harness\":\"grok\",\"host\":\"{{ .chezmoi.hostname }}\",\"agent\":\"primary\"}" }

[model."vmc/grok"]
model = "vmc/grok"
base_url = "https://ai-gateway.vercel.sh/v1"
name = "Vercel AI Gateway (vmc/grok)"
env_key = "AI_GATEWAY_API_KEY"
api_backend = "chat_completions"
