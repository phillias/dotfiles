.chezmoi.toml
.chezmoiignore
.chezmoi-inventory.json
age-key.txt.age

# Literal .config/ path (chezmoi uses dot_config/ prefix convention instead)
# .config  - Disabled to allow dot_config/ prefix convention for ~/.config/

# Machine-specific git identity — different per box
.gitconfig

# SSH known_hosts — mutable per-machine, changes on every new connection
.ssh/known_hosts

# Profile build artifacts — npm state varies per machine
.config/opencode/profiles/*/node_modules
.config/opencode/profiles/*/node_modules/**
.config/opencode/profiles/*/package-lock.json
.config/opencode/profiles/*/bun.lock

# npm artifacts — repo uses pnpm (pnpm-lock.yaml is managed)
.config/opencode/package-lock.json
.config/opencode/plugins/package-lock.json

# Machine-local LSP install decisions
.config/opencode/lsp-install-decisions.json

# Python build artifacts — regenerated per machine
.agents/**/__pycache__/**
.agents/**/__pycache__

# Third-party plugin clones (each is its own git repo, not a dotfile) —
