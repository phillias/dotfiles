# opencode runtime on plugin install; dotfiles track configs only (2026-08-04)
.config/opencode/package.json
.config/opencode/package-lock.json
.config/opencode/pnpm-lock.yaml
.config/opencode/pnpm-workspace.yaml
.config/opencode/plugins/package.json
.config/opencode/plugins/package-lock.json
.config/opencode/plugins/bun.lock

# Machine-local LSP install decisions
.config/opencode/lsp-install-decisions.json

# Python build artifacts — regenerated per machine
.agents/**/__pycache__/**
.agents/**/__pycache__

# notty-shell-hang-guardrails loads via the opencode.json instructions key (md path).

# npm artifacts — plugins/ node_modules (auto-load dir deps; source .ts tracked)
.config/opencode/plugins/node_modules
.config/opencode/plugins/node_modules/**

