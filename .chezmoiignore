# Literal .config/ path (chezmoi uses dot_config/ prefix convention instead)
# .config  - Disabled to allow dot_config/ prefix convention for ~/.config/

# Machine-specific git identity — different per box
.gitconfig

# SSH known_hosts — mutable per-machine, changes on every new connection
.ssh/known_hosts

# Profile build artifacts — npm state varies per machine
.config/opencode/profiles/*/node_modules
.config/opencode/profiles/*/node_modules/**
.config/opencode/profiles/*/package-lock.json
.config/opencode/profiles/*/bun.lock

