#!/usr/bin/env bash
set -euo pipefail

{{- $node := "" }}
{{- $zone := "" }}
{{- $tunnel_id := "" }}
{{- range $key, $val := .fleet.nodes }}
{{-   if eq $val.hostname $.chezmoi.hostname }}
{{-     $node = $key }}
{{-     $zone = $val.tunnel_zone }}
{{-     $tunnel_id = $val.tunnel_id }}
{{-   end }}
{{- end }}

{{- if and $tunnel_id $zone }}

CF_CONFIG="/etc/cloudflared/config.yml"
CF_CRED="/etc/cloudflared/{{ $tunnel_id }}.json"

if [ ! -f "$CF_CRED" ]; then
    echo "cloudflared-config: credentials $CF_CRED not found, skipping"
    exit 0
fi

TMPFILE=$(mktemp)
cat > "$TMPFILE" << YAML
tunnel: {{ $tunnel_id }}
credentials-file: $CF_CRED

warp-routing:
  enabled: true

ingress:
  - hostname: ssh.{{ $zone }}
    service: ssh://localhost:22
  - hostname: et.{{ $zone }}
    service: tcp://localhost:2022
  - service: http_status:404
YAML

if sudo tee "$CF_CONFIG" > /dev/null < "$TMPFILE"; then
    sudo chmod 644 "$CF_CONFIG"
    rm -f "$TMPFILE"
    echo "cloudflared-config: wrote $CF_CONFIG for tunnel {{ $tunnel_id }}"
else
    rm -f "$TMPFILE"
    echo "cloudflared-config: failed to write $CF_CONFIG (need sudo)" >&2
    exit 1
fi

{{- if eq $node "primary" }}
OLD_UNIT="opencode-tunnel-primary55522.service"
if systemctl --user is-enabled "$OLD_UNIT" &>/dev/null; then
    systemctl --user stop "$OLD_UNIT" 2>/dev/null || true
    systemctl --user disable "$OLD_UNIT" 2>/dev/null || true
    rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$OLD_UNIT"
    systemctl --user daemon-reload
    echo "cloudflared-config: cleaned up old unit $OLD_UNIT"
fi
{{- end }}

{{- else }}

echo "cloudflared-config: no tunnel_id/zone for host {{ .chezmoi.hostname }}, skipping"

{{- end }}
