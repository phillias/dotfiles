# dnsmasq mesh DNS configuration — serves *.mesh hostnames
# Managed by chezmoi; do not edit locally.
#
# The mesh-hosts file provides hostname→IP mappings,
# kept current by the mesh-ddns systemd timer. dnsmasq listens on
# all interfaces so that both local and mesh-network queries are served.

# Serve .mesh domain from the mesh-hosts file
addn-hosts=/var/lib/dnsmasq/mesh-hosts

# Resolve .mesh locally (do not forward upstream)
local=/mesh/
domain=mesh

# dnsmasq listens on all interfaces by default.
