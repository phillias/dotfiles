# dnsmasq mesh DNS configuration — serves *.mesh hostnames
# Managed by chezmoi; do not edit locally.
#
# The mesh-hosts file provides hostname→IP mappings,
# kept current by the mesh-ddns systemd timer. dnsmasq binds only to
# loopback plus this node's LAN IP (never 0.0.0.0) to avoid port 53
# conflicts with systemd-resolved and warp-svc. The LAN IP is reachable
# from other WARP devices via Cloudflare Tunnel private routes.
# mesh-ddns rewrites the listen-address line at runtime to add the mesh IP too.

# Serve .mesh domain from the mesh-hosts file
addn-hosts=/var/lib/dnsmasq/mesh-hosts

# Resolve .mesh locally (do not forward upstream)
local=/mesh/
domain=mesh

# Never bind all interfaces — loopback + LAN IP only.
bind-interfaces

# Never use /etc/resolv.conf as upstream — .mesh is served locally only.
no-resolv

# Safe default bind address; mesh-ddns rewrites this line at runtime to
# "listen-address=127.0.0.1,<mesh-ip>,<lan-ip>" so local, mesh, and LAN queries work.
listen-address=127.0.0.1{{ range $name, $node := .fleet.nodes }}{{ if eq $node.hostname $.chezmoi.hostname }},{{ $node.lan_ip }}{{ end }}{{ end }}
