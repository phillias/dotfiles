[Unit]
# Secrets (CF_AI_GATEWAY_TOKEN, VERCEL_TOKEN, CLOUDFLARE_DEPLOY_TOKEN) are
# resolved at runtime by bws-exec.sh via the shared BWS loader
# (~/.agents/keys/load-keys.sh, fail-soft 5min→24h cache). provider-catalog.env
# remains as a fallback for nodes without BWS; do NOT put a static
# CF_AI_GATEWAY_TOKEN there — a stale copy shadows the vault token and causes
# silent 401s (the 2026-10-15 → 10-24 monitoring blind spot).
# bws-exec.sh maps CLOUDFLARE_DEPLOY_TOKEN → CLOUDFLARE_API_TOKEN for wrangler.
Description=Provider-catalog deterministic dynamic-route audit (D1 mirror)

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/opencode/provider-catalog.env
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
SuccessExitStatus=1
ExecStart=%h/.config/opencode/scripts/bws-exec.sh %h/.config/opencode/scripts/dynamic-audit.mjs
