[Unit]
Description=CodeBurn Share Service (Federation)
After=network.target

[Service]
Type=simple
WorkingDirectory={{ .chezmoi.homeDir }}
ExecStart={{ .chezmoi.homeDir }}/.local/share/mise/shims/codeburn share --always --port 7777
Restart=always
RestartSec=10
Environment=NODE_ENV=production
Environment=HOME={{ .chezmoi.homeDir }}

[Install]
WantedBy=default.target
