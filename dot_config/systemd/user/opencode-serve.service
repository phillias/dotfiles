[Unit]
Description=OpenCode Headless Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Keep the headless server's opencode config tree independent from interactive TUI config.
# Web UI auth (username/password) comes from the static env file below; the
# gateway token comes from the bws-first login env via the ExecStartPre
# harvest (2026-10-17) - same treatment as the no-mistakes daemon (PR #442).
# The old static env rendered provider keys from retired age files (stale
# leaked values); the serve tree references only CF_AI_GATEWAY_TOKEN.
Environment=XDG_CONFIG_HOME=%h/.config/opencode-serve
ExecStartPre=%h/.local/bin/opencode-serve-env-harvest.sh
ExecStart=%h/.local/share/mise/shims/opencode serve --port 4096 --hostname 127.0.0.1 --pure --log-level WARN
Restart=on-failure
RestartSec=30

EnvironmentFile=%h/.config/opencode/opencode-serve.env
EnvironmentFile=-/run/user/1000/opencode-serve.env
IOWeight=10
IOWriteBandwidthMax=/dev/sda 5M
IOReadBandwidthMax=/dev/sda 10M
# Envelope sized for the pure headless role
CPUQuota=100%
MemoryMax=768M
Nice=10

[Install]
WantedBy=default.target
