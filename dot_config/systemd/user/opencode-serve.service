[Unit]
Description=OpenCode Headless Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Single config tree: serve reads ~/.config/opencode directly (same as TUI).
# The XDG_CONFIG_HOME override to ~/.config/opencode-serve was removed because
# it created a parallel config tree that had to be manually synced and diverged
# silently. opencode's schema already distinguishes server-side from client-side
# keys; serve ignores TUI themes regardless of which tree it reads.
# Web UI auth (username/password) comes from the static env file below; the
# gateway token comes from the bws-first login env via the ExecStartPre
# harvest (2026-10-17) - same treatment as the no-mistakes daemon (PR #442).
ExecStartPre=%h/.local/bin/opencode-serve-env-harvest.sh
ExecStart=%h/.local/share/mise/shims/opencode serve --port 4096 --hostname 127.0.0.1 --log-level WARN
Restart=on-failure
RestartSec=30

EnvironmentFile=%h/.config/opencode/opencode-serve.env
EnvironmentFile=-%t/opencode-serve.env
IOWeight=10
IOWriteBandwidthMax=/dev/sda 5M
IOReadBandwidthMax=/dev/sda 10M
# Envelope sized for the headless role
CPUQuota=100%
MemoryMax=768M
Nice=10

[Install]
WantedBy=default.target
