# ~/.config/hermes/config.yaml — chezmoi-managed
# Hermes CLI runtime configuration

api:
  listen: "{{ dig "hermes" "listenAddr" "127.0.0.1:8443" . }}"
  tls_enabled: false

paths:
  mybrain: "{{ dig "mybrain" "repoPath" "$HOME/mybrain" . }}"
  data: "{{ dig "mybrain" "repoPath" "$HOME/mybrain" . }}/data"
  wiki: "{{ dig "mybrain" "repoPath" "$HOME/mybrain" . }}/wiki"
  scripts: "{{ dig "mybrain" "repoPath" "$HOME/mybrain" . }}/scripts/hermes"
  env_file: "{{ .chezmoi.homeDir }}/.hermes-env"

cron:
  jobs_file: "{{ .chezmoi.homeDir }}/.local/share/hermes/cron/jobs.json"

mcp:
  servers:
    - name: mybrain-brain
      command: "{{ dig "mybrain" "repoPath" "$HOME/mybrain" . }}/.venv/bin/python3"
      args:
        - "{{ dig "mybrain" "repoPath" "$HOME/mybrain" . }}/scripts/hermes/mybrain-mcp-server.py"
      env:
        MYBRAIN_DB_PATH: "{{ dig "mybrain" "repoPath" "$HOME/mybrain" . }}/data/brain.db"

logging:
  level: "{{ dig "hermes" "logLevel" "info" . }}"
  directory: "{{ .chezmoi.homeDir }}/.local/share/hermes/logs"

# ── AI Gateway integration ──────────────────────────────────────
# Hermes job scripts and MCP servers can route AI calls through
# the CF AI Gateway with identity tracking. Configure gateway
# routing in ~/.hermes-env (see dot_hermes-env.tmpl).
#
# Example job script using the gateway:
#   #!/bin/bash
#   source ~/.hermes-env
#   # Use $HERMES_MODEL_ROUTE or explicit cf-aig-dynamic provider
#   curl -X POST "$ANTHROPIC_BASE_URL/v1/messages" \
#     -H "Authorization: Bearer $ANTHROPIC_API_KEY" \
#     -H "Content-Type: application/json" \
#     -H "cf-aig-gateway-id: opencode" \
#     -H "cf-aig-metadata: {\"harness\":\"hermes\",\"host\":\"{{ .chezmoi.hostname }}\",\"agent\":\"cron-job\"}" \
#     -d "{\"model\": \"$HERMES_MODEL_ROUTE\", \"messages\": [...]}"
#
# Identity tracking metadata schema:
#   harness: "hermes" (fixed, identifies this scheduler)
#   host: dynamic hostname via chezmoi template
#   agent: "cron-job" or job-specific identifier
#
# Dashboard filtering:
#   metadata.harness == "hermes" && metadata.host == "<hostname>"
