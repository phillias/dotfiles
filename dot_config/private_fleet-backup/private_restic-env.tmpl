{{- /*
  Fleet restic environment — per-host config templated by chezmoi.
  Sources shared secrets (age-encrypted) and per-host password (age-encrypted).
  Sets per-host RESTIC_REPOSITORY, BACKUP_PATHS, HOST_TAG, EXCLUDES.
  Generated by chezmoi — do not edit the deployed file.
*/ -}}
{{- $node := "unknown" -}}
{{- if eq .chezmoi.hostname .fleet.nodes.kali.hostname }}{{- $node = "kali" -}}
{{- else if eq .chezmoi.hostname .fleet.nodes.phillias.hostname }}{{- $node = "phillias" -}}
{{- else if eq .chezmoi.hostname .fleet.nodes.primary55522.hostname }}{{- $node = "primary55522" -}}
{{- end -}}
# Fleet restic environment — per-host config (chezmoi template).
# Shared secrets and per-host password are sourced from separate age-encrypted files.

# Source shared secrets (AWS keys, ntfy token, OCI bucket base URL)
# shellcheck source=/dev/null
source "$HOME/.config/fleet-backup/restic-shared-secrets"

# Source per-host RESTIC_PASSWORD (selected by .chezmoiignore — only one deploys)
# shellcheck source=/dev/null
source "$HOME/.config/fleet-backup/restic-password-{{ $node }}"

# Per-host repository subpath under the shared OCI bucket
export RESTIC_REPOSITORY="${RESTIC_BUCKET_BASE}/{{ $node }}"

# Host tag for restic snapshots
export HOST_TAG="{{ $node }}"

# Universal backup paths (configs and essential state — no cache)
BACKUP_PATHS=(
  "$HOME/firstmate"
  "$HOME/.agents"
  "$HOME/.config/opencode"
  "$HOME/.local/share/opencode"
  "$HOME/memories"
  "$HOME/.no-mistakes"
  "$HOME/docker/selfhost"
{{- if eq $node "primary55522" }}
  "$HOME/.local/share/bench-studio"
{{- end }}
)

# Excludes — applied to all hosts
EXCLUDES=(
  --exclude="$HOME/.config/opencode/node_modules"
  --exclude="$HOME/.local/share/opencode/log"
  --exclude="$HOME/.local/share/opencode/tool-output"
  --exclude="*.log"
)
