        "opencode-go/glm-5.1",
        // Command Code GOAT ($70 pool) - lowest GLM-5.x mainline on GOAT
        "commandcode/zai-org/GLM-5.2",
        // OpenRouter GLM-5 (cheapest per-token mainline, $0.60/$1.92)
        "openrouter/z-ai/glm-5",
        // OpenCode Zen GLM-5.1 (128k)
        "opencode-zen/glm-5.1"
