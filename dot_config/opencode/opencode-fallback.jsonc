{
  // TWO-PATH ARCHITECTURE (captain decision 2026-09-19):
  // Path 1 - CF AI Gateway dynamic/TUI route: cascading GLM ladder
  //   (free → subsidized → PAYG, NO opencode-go - session-gated).
  // Path 2 - This fallback config: CfAiGw/dynamic/TUI first → Vercel → opencode-go tail.
  // The gateway route owns intra-GLM cascade; this chain owns the
  // gateway-vs-direct-client hop. opencode-go can never be a gateway
  // route node (x-opencode-session header requirement).
  //
  // Fleet taxonomy: the global ladder is firstmate's + every secondmate's
  // session chain (no agent name → resolves here). `agents` covers crewmate
  // subagent types. `categories` covers firstmate's
  // dispatch categories. Resolution order: session model → agent (exact,
  // then longest `*` wildcard) → category → global ladder.
  "enabled": true,
  "retry_on_errors": [400, 401, 402, 403, 429, 500, 502, 503, 504, 529],
  "max_fallback_attempts": 20,
  "cooldown_seconds": 15,
  "timeout_seconds": 30,
  "notify_on_fallback": true,

  // GLOBAL LADDER — firstmate & secondmate main sessions (agent=undefined),
  // and the deduped tail of every non-no_global_tail chain.
  // Two-stage architecture:
  // - Stage 0: zen + opencode-go direct lanes (in-app identity passes both gates)
  // - Stage 1: CF AI Gateway CfAiGw/dynamic/TUI route (NIM free GLM head →
  //   GOAT/PGS GLM → openrouter PAYG; zen pulled out 2026-10-05)
  // - Stage 2: Vercel AI Gateway fallback route
  "fallback_models": [
    // STAGE 0 (2026-10-05, captain-ordered re-home of the zen models pulled out
    // of CfAiGw/dynamic/TUI — route-forwarded requests lose the in-app identity
    // and hit 403 FreeTierError). In-app reality, live-verified 2026-10-06:
    // zen has NO free glm tier (glm-5.2:free = "Model is unavailable"), and
    // paid glm-5.2 / glm-5.3-flash server-error in-app — of the paid GLM trio
    // only glm-5.1 serves in-app (all three serve on the gateway-token route
    // path, which this chain cannot use). Free GLM: openrouter z-ai/glm-5.2:free
    // was wired at head per captain 2026-10-06, then died upstream the same day
    // (probe: "This model is unavailable for free. The paid version is
    // available now - use this slug instead: z-ai/glm-5.2"; the live models
    // list shows NO free glm lanes left) — pulled: a dead head is a wasted or
    // fatal first hop (404 is not in retry_on_errors). Free GLM now leads
    // the chain at stage 1 (NIM glm-5.3 TUI head).
    // longcat-2.5-preview-free dropped (captain 2026-10-05).
    "opencode-zen/glm-5.1",
    "opencode-go/glm-5.1",
    "opencode-go/deepseek-v4-flash",
    "opencode-zen/mimo-v2.5-free",

    // STAGE 1: Gateway dynamic route (cascading GLM ladder)
    // Route handles free → subsidized → PAYG internally
    // Budget: GLM 5.1 → 5.2 → 5.3 preference
    "CfAiGw/dynamic/TUI",
    
    // STAGE 2: Vercel AI Gateway fallback route
    "vercel/vmc/tui"

  ],

  // CREWMATES — subagent types firstmate dispatches via task(subagent_type=...).
  "agents": {
    // Utility crewmates: Gateway route first → Vercel → opencode-go fallback
    "general": {
      "model": "opencode-go/longcat-2.5-preview-free",
      "fallback_models": [
        "opencode-go/glm-5.1",
        "opencode-go/deepseek-v4-flash",
        "CfAiGw/dynamic/TUI",
        "vercel/vmc/tui"
      ]
    },
    "explore": {
      "model": "opencode-go/longcat-2.5-preview-free",
      "fallback_models": [
        "opencode-go/glm-5.1",
        "opencode-go/deepseek-v4-flash",
        "CfAiGw/dynamic/TUI",
        "vercel/vmc/tui"
      ]
    },
    // Specialized flywheel agents: models pinned, fallback Z.AI → GOAT → Go → Zen only.
    "self-improve": {
      "model": "opencode-zen/glm-5.1",
      "fallback_models": [
        "zai-coding/glm-5.2",
        "commandcode/zai-org/GLM-5.1",
        "opencode-go/glm-5.1",
        "opencode-zen/kimi-k2.6"
      ],
      "no_global_tail": true
    },
    "solutions-research": {
      "model": "opencode-zen/nemotron-3-ultra-free",
      "fallback_models": [
        "commandcode/moonshotai/Kimi-K2.6",
        "opencode-zen/kimi-k2.6"
      ],
      "no_global_tail": true
    }
  },

  // DISPATCH CATEGORIES — firstmate picks at the intent gate via
  // dispatch-rules.json → task(category=...).
  "categories": {
    // UTILITY (decision A): Gateway route first → Vercel → opencode-go fallback.
    "quick": {
      "model": "CfAiGw/dynamic/TUI",
      "fallback_models": [
        "vercel/vmc/tui",
        "opencode-go/glm-5.1",
        "opencode-go/deepseek-v4-flash"
      ]
    },
    "unspecified-low": {
      "model": "CfAiGw/dynamic/TUI",
      "fallback_models": [
        "vercel/vmc/tui",
        "opencode-go/glm-5.1",
        "opencode-go/deepseek-v4-flash"
      ]
    },
    // HIGH-INTENSITY / SPECIALIZED (decision A): models pinned, fallback
    // GOAT→Go→Zen only — no free downgrade; exhaustion fails loudly.
    "ultrabrain": {
      "model": "opencode-go/deepseek-v4-pro",
      "variant": "xhigh",
      "fallback_models": [
        "commandcode/deepseek/deepseek-v4-pro",
        "opencode-zen/deepseek-v4-pro"
      ],
      "no_global_tail": true
    },
    "deep": {
      "model": "opencode-go/kimi-k2.6",
      "fallback_models": [
        "zai-coding/glm-5.2",
        "commandcode/moonshotai/Kimi-K2.6",
        "opencode-go/kimi-k2.6",
        "opencode-zen/kimi-k2.6"
      ],
      "no_global_tail": true
    },
    "unspecified-high": {
      "model": "opencode-go/kimi-k2.6",
      "fallback_models": [
        "zai-coding/glm-5.2",
        "commandcode/moonshotai/Kimi-K2.6",
        "opencode-go/kimi-k2.6",
        "opencode-zen/kimi-k2.6"
      ],
      "no_global_tail": true
    },
    "visual-engineering": {
      "model": "opencode/gpt-5.3-codex",
      "fallback_models": [
        "commandcode/gpt-5.6-luna",
        "opencode-zen/gpt-5.3-codex"
      ],
      "no_global_tail": true
    },
    "artistry": {
      "model": "opencode-zen/gemini-3.5-flash",  // CF AI Gateway gemma dropped 2026-09-11 (never resolved routing)
      "fallback_models": [
        "commandcode/xiaomi/mimo-v2.5",
        "commandcode/thinkingmachines/inkling",
        "opencode-go/mimo-v2.5",
        "opencode-zen/mimo-v2.5-free"
      ],
      "no_global_tail": true
    },
    "writing": {
      "model": "opencode-zen/deepseek-v4-flash-free",
      "fallback_models": [
        "commandcode/deepseek/deepseek-v4-flash",
        "opencode-go/deepseek-v4-flash"
      ],
      "no_global_tail": true
    }
  }
}
