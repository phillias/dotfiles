# Global agent rules — TOON encoding of AGENTS.md (converted 2026-08-04).
# Original snapshot: ~/.config/opencode/AGENTS.md.bak

rules: "set_git_identity_before_commit|conventional_commits|no_hardcoded_home_paths|no_commit_without_request|no_type_error_suppression|no_speculation_about_unread_code|never_leave_broken_state|no_force_push_without_approval|no_config_edits_unasked|no_lfg"

git:
  identity: "before any commit: GIT_AUTHOR_NAME + GIT_COMMITTER_NAME = <active-model>@<hostname>"
  identity_src: "opencode debug config -> grep '\"model\"' -> first match; fallback $OPENCODE_MODEL; else ask user on first commit"
  format: "<model>@<hostname> (e.g. big-pickle@nasbox)"
  conventional: "<type>(<scope>): <description>"
  types: "feat|fix|chore|docs|style|refactor|perf|test|ci|build"

paths:
  rule: "never hardcode /home/<user> or /Users/<user> in configs|units|skills|scripts|plugins|docs|omo configs"
  shell_scripts: "$HOME"
  configs_docs: "~"
  chezmoi_tmpl: "{{ .chezmoi.homeDir }}"
  systemd_units: "%h"
  opencode_configs: "{env:HOME}"
  archive_exception: "ARCHIVE.md|MIGRATION.md may retain pre-parity paths as documentation"

pr:
  pre_push: "check for existing PR: gh pr view --json title,body,state,baseRefName; or check branch upstream"
  if_pr_exists: "push new commits, then gh pr edit to update body"
  if_no_pr: "create feature branch -> push -> gh pr create --base master"
  base_inference: "compare git merge-base against master|develop|likely upstream branches; pick closest (smallest divergence)"

docker:
  service_discovery: "given live URL/container name, locate compose dir via the RUNNING container before grep-ing the filesystem"
  step1: "docker ps | grep <name-or-port-from-url>"
  step2: "docker inspect <container> | grep -iE 'WorkingDir|com.docker.compose.*Working.*Dir|com.docker.compose.project.config_files'"
  why: "the runtime knows where a running container came from; the filesystem does not"

ce:
  integration: "when compound-engineering installed (~/.agents/skills/ce-*), route planning/execution through CE skills, not the built-in OmO plan agent"
  domain_alignment: "CONTEXT.md exists + non-trivial scope -> offer /grill-with-docs before planning"
  domain_no_ctx: "no CONTEXT.md + fuzzy terminology -> optionally offer grill-with-docs"
  domain_greenfield: "greenfield + large feature -> offer initial CONTEXT.md via grill-with-docs"
  domain_trivial: "skip domain alignment"
  routing_trivial: "execute directly - no plan"
  routing_clear: "/ce-plan -> plan -> /ce-work -> execute -> /ce-code-review -> ship"
  routing_ambiguous: "/ce-brainstorm -> requirements doc -> /ce-plan -> /ce-work"
  routing_bug: "/ce-debug -> fix -> /ce-compound (optional)"
  plan_storage: "docs/plans/ by default; .omo/plans/ when .omo/ exists (triggers OmO Momus review)"
  execution: "/ce-work <plan-path> after ce-plan"
  review_chain: "ce-doc-review after ce-plan (headless)|Momus on .omo/plans/|ce-code-review after ce-work|ce-resolve-pr-feedback post-PR"

guardrails: "no git push --force|--force-with-lease without explicit confirmation|no git reset --hard on branch with unpushed commits|no git branch -D|no git rebase --onto on shared branches|no deleting files outside project scope|no modifying ~/.config/opencode/ without being asked"

ce_skills:
  plan: "ce-plan: structured planning with confidence gating; durable plans in docs/plans/"
  code_review: "ce-code-review: parallel multi-agent review, tiered personas; mode:autofix|mode:report-only"
  debug: "ce-debug: root-cause analysis, test-first fixes"
  compound: "ce-compound: document solved problems to docs/solutions/"
  brainstorm: "ce-brainstorm: interactive requirements exploration -> requirements doc"
  optimize: "ce-optimize: iterative optimization loops with measurement gates"
  strategy: "ce-strategy: create/maintain STRATEGY.md"
  invocation: "use the skill tool with name: ce-<skill>; never use /lfg (removed - token-heavy, conflicts with ultrawork discipline)"

model_budget: "CE sub-agents are pinned to budget-optimized models - never override their model assignments; session model used for skill entry points only"

token_budget: "first-class design constraint: every tool output, API response format, and skill instruction minimizes token consumption without sacrificing signal"
axi_source: "authoritative: AXI skill (~/.agents/skills/axi/SKILL.md); load when building/reviewing CLIs or agent-facing tooling; do NOT load for general coding, debugging, infra, or code review"
axi_principles[10]{n,principle}:
  1,token-efficient_output|TOON ~40% fewer tokens than JSON
  2,minimal_default_schemas|3-4 fields, not 10
  3,content_truncation|large output with size hints + --full
  4,pre-computed_aggregates|total counts in list output
  5,definitive_empty_states|state the zero with context
  6,structured_errors_and_exit_codes|errors to stdout, no interactive prompts
  7,ambient_context|session hooks before skills
  8,content_first|no args = live data, not usage text
  9,contextual_disclosure|next-step suggestions after output
  10,consistent_help|--help per subcommand

dispatch:
  rules_file: "~/.config/opencode/dispatch-rules.json"
  evaluation: "1) explicit user instructions in this turn win|2) first matching rule|3) default block"
  when_skip: "trivially obvious task|user mid-clarification|task already in flight with dispatched agent"
  judgment: "rules are advisory, not literal; explicit user overrides always win; ambiguous tasks may consult metis/oracle before dispatching"

fleet:
  purpose: "zero-token background-task status sidecar (survives chat.message hook-chain failure / compaction)"
  state_dir: "~/.local/state/opencode-fleet/"
  wake_log: "TSV append-only: <ISO-ts><TAB><type><TAB><session_id><TAB><digest>; rotates >1MB to last 1000 lines"
  state_json: "JSON snapshot, rewritten in place; tasks map keyed by session_id or task_id"
  digest_txt: "TSV snapshot: <key><TAB><status><TAB><type><TAB><digest><TAB><age> ago"
  writer: "~/.config/opencode/plugins/fleet-state-writer.ts; hooks: event (session.*), chat.message (BG headers), tool.execute.after (background_output); zero LLM cost"
  reader: "~/.config/opencode/scripts/fleet-digest.sh; flags: --since N|--wakes-only|--json"
  consult: "at session start|after system-reminder suggesting bg completion|before dispatching a new task|when user asks what's running"
  failure_mode: "state.json empty/missing -> fall back to background_output API; wake.log corrupt -> truncate; state tree is NEVER the source of truth (that's opencode.db)"

learning:
  golden_paths: "multi-step win that only worked after attempts -> promote to skill via self-learning; promote only when: verified (passing check) + repeatable verification step + named failure pattern + >=1 ruled-out dead-end; else low-confidence mem note (--confidence 0.2)"
  facts: "single facts/corrections -> axi-memory (mem add --type constraint|decision|failure|howto|preference), not a skill"
  seeding: "short research items -> mem add directly (decision/howto, --priority 50); expected many and shallow"
  struggle_sessions: "multi-step win -> skill; single-step win -> mem add --type howto|failure --priority 75+; never let them fall through"
  dedup: "after any batch of adds run mem dedup --dry-run (OS-side normalized-title Jaccard, zero LLM); --apply merges keeping higher priority; escalate to LLM judgment only when the heuristic looks wrong"
  secrets: "never write secret values into skills or memory; record WHERE they live (env var|vault|MCP tool), never the value"
  autocapture: "plugin writes cues to ~/.local/state/opencode-selflearning/cues.tsv; at session start if non-empty: hard-win cues always harvest|explicit cues always|session cues only if the session contains a verified win; then append processed lines to processed.tsv and truncate cues.tsv; after harvesting run mem dedup --apply"
  evidence: "plugin writes evidence.tsv (session-error|model-fallback rows) alongside cues; at session start triage new evidence rows -> mem add --type failure (root cause + fix), never skill promotion without a verified win"
  skill_review: "skills_review.tsv non-empty at session start -> read each line, report flagged skills one line each, propose keep|update|demote-to-mem|retire; NEVER demote or delete without explicit user approval; retire = move to _review/ or convert to low-confidence mem note, never delete; record decisions in review-decisions.tsv; when retiring append <skill><TAB><retiredTs> to retired.tsv; re-promotion is manual + user-approved"
