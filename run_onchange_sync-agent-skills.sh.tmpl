#!/bin/bash
# Sync unmanaged files from target directories into the chezmoi source tree,
# AND prune deprecated session-generated skills (consolidated housekeeping).
#
# This is a run_onchange script — re-runs when its rendered content changes.
# A fingerprint of the target directories is embedded below via chezmoi
# template expressions. Adding a new file on disk drifts the fingerprint,
# which changes the rendered content, which triggers a re-run on the next
# `chezmoi apply`. Pruning is therefore self-maintaining: any deprecated
# skill that shows up on any machine is removed on the next apply that
# observes a change.
#
# Managed directories:
#   ~/.agents/                  → dot_agents/
#   ~/.config/opencode/         → dot_config/opencode/
#   ~/.config/systemd/user/     → dot_config/systemd/user/
#   ~/.omo/plans/               → private_dot_omo/plans/  (plans only, not state)
#
# Fingerprint (agents):   {{ output "bash" "-c" "find ~/.agents -type f 2>/dev/null | sort | xargs sha256sum 2>/dev/null | sha256sum | cut -d' ' -f1" }}
# Fingerprint (opencode): {{ output "bash" "-c" "find ~/.config/opencode -maxdepth 1 -type f -o -path '*/skills/*' -type f -o -path '*/agents/*' -type f -o -path '*/plugins/*' -type f -o -path '*/themes/*' -type f -o -path '*/scripts/*' -type f -o -path '*/docs/*' -type f -o -path '*/compound-engineering/*' -type f 2>/dev/null | sort | xargs sha256sum 2>/dev/null | sha256sum | cut -d' ' -f1" }}
# Fingerprint (systemd):  {{ output "bash" "-c" "find ~/.config/systemd/user -type f 2>/dev/null | sort | xargs sha256sum 2>/dev/null | sha256sum | cut -d' ' -f1" }}
# Fingerprint (omoplans): {{ output "bash" "-c" "find ~/.omo/plans -type f 2>/dev/null | sort | xargs sha256sum 2>/dev/null | sha256sum | cut -d' ' -f1" }}
set -euo pipefail

# ---------------------------------------------------------------- deprecated ---
# One-off skills generated by past agent sessions. They are task records, not
# reusable tools — the work they documented is done or superseded. Add new
# session-generated strays here so every machine prunes them on next apply.
DEPRECATED_SKILLS=(
    agents-md-add-omo-to-ce-routing-rules-for-the-inte
    bridge-skill-create-omo-ce-bridge-skill-md-with-in
    bws-secrets-created-8-new-secrets
    ce-plan-skill-md-add-optional-omo-plans-output-sup
    chezmoi-add-new-tracked-files-and-push-to-pr-86
    chezmoi-re-add-tracked-files-add-new-untracked-plu
    create-missing-bws-secrets-db-password-pg-db-passw
    create-pr-in-dotfiles-repo-with-all-changes
    deploy-and-verify-services
    install-matt-pocock-s-grill-with-docs-skill-locall
    pirate-infra-mgmt
    pirate-stack
    recreate-mariadb-and-pocketid-containers-with-new-
    selfhost-cloudbeaver
    selfhost-compose-remove-mariadb-init-tinyauth-init
    tinyauth-add-depends-on-locket-for-raw-env-injecti
    update-ce-brainstorm-skill-md-add-context-md-to-ph
    update-ce-workflow-skill-md-add-phase-0-5a-domain-
    update-mssql-connection-password-via-api
)

# Tool skills installed via `npx skills add` / plugin bundles. They are
# intentionally NOT tracked in the dotfiles repo — never suggest adding them.
TOOL_SKILLS=(
    agents-sdk
    chrome-devtools-mcp
    cloudflare
    cloudflare-email-service
    cloudflare-one
    cloudflare-one-migrations
    codegraph-mcp
    durable-objects
    google-workspace-mcp
    lfg
    netdata-mcp
    sandbox-sdk
    turnstile-spin
    web-perf
    workers-best-practices
    wrangler
)

prune_deprecated() {
    local dir="$1"
    [[ -d "$dir" ]] || return 0
    local name
    for name in "${DEPRECATED_SKILLS[@]}"; do
        if [[ -e "$dir/$name" ]]; then
            rm -rf "$dir/$name"
            echo "pruned deprecated skill: $name"
        fi
    done
}

is_tool_skill() {
    local name
    name=$(basename "$(dirname "$1")")
    local ts
    for ts in "${TOOL_SKILLS[@]}"; do
        [[ "$name" == "$ts" ]] && return 0
    done
    return 1
}

# ------------------------------------------------------------------ prune -----
prune_deprecated "$HOME/.config/opencode/skills"
prune_deprecated "$HOME/.agents/skills"

# -------------------------------------------------------------- sync/unmanaged -
# Use 'chezmoi unmanaged' to find files not tracked by chezmoi.
# This correctly handles chezmoi's naming conventions (dot_, private_, executable_, etc.)
unmanaged=()

# Helper: collect unmanaged files from a target directory
collect_unmanaged() {
    local target_dir="$1"
    [[ -d "$target_dir" ]] || return 0

    while IFS= read -r -d '' file; do
        # Skip noise files
        case "$file" in
            */.git/*|*/node_modules/*|*.log|*.tmp) continue ;;
        esac
        # Skip installed tool skills — tracked upstream, not in dotfiles
        is_tool_skill "$file" && continue
        unmanaged+=("$file")
    done < <(chezmoi unmanaged --include files --path-style absolute --nul-path-separator "$target_dir" 2>/dev/null || true)
}

# Scan each managed directory
collect_unmanaged "$HOME/.agents"
collect_unmanaged "$HOME/.config/opencode"
collect_unmanaged "$HOME/.config/systemd/user"
collect_unmanaged "$HOME/.omo/plans"

if [[ ${#unmanaged[@]} -eq 0 ]]; then
    echo "sync-dotfiles: all files managed, nothing to do"
    exit 0
fi

# NOTE: We cannot call 'chezmoi add' here because this script runs while
# chezmoi holds the state lock. Calling chezmoi add would deadlock.
# Instead, print the list so the user can run it after the update completes.

echo "sync-dotfiles: found ${#unmanaged[@]} unmanaged file(s):"
echo ""
echo "  Run the following to add them:"
echo ""
for file in "${unmanaged[@]}"; do
    echo "    chezmoi add '$file'"
done
echo ""
echo "  Or run: chezmoi add ${unmanaged[0]} ... (all files listed above)"
